<Window x:Class="StellarExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="StellarExplorer"
        Height="750"
        Width="1200"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#080B16">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Application Header -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#111827"
                Padding="20">

            <DockPanel LastChildFill="True">

                <TextBlock Text="STELLAR EXPLORER"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <TextBlock Text="3D STAR CHART"
                           Foreground="#8FA9D6"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>

            </DockPanel>
        </Border>

        <!-- 3D Star Visualisation Area -->
        <Grid Grid.Row="1"
              Grid.Column="0"
              Background="#080B16">

            <h:HelixViewport3D x:Name="StarViewport"
                               Background="#080B16"
                               ShowCoordinateSystem="True"
                               ShowViewCube="True"
                               ZoomExtentsWhenLoaded="True">

                <!-- Camera Configuration -->
                <h:HelixViewport3D.Camera>
                    <PerspectiveCamera Position="0,0,100"
                                       LookDirection="0,0,-100"
                                       UpDirection="0,1,0"
                                       FieldOfView="45"/>
                </h:HelixViewport3D.Camera>

                <!-- Scene Lighting -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <DirectionalLight Color="White"
                                          Direction="-1,-1,-2"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

            </h:HelixViewport3D>

        </Grid>

        <!-- Star Details Panel -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="#111827"
                BorderBrush="#26364F"
                BorderThickness="1,0,0,0"
                Padding="18">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- Panel Heading -->
                    <TextBlock Text="STAR DETAILS"
                               Foreground="#8FA9D6"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <!-- Camera Navigation Buttons -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,18">

                        <Button Content="Fly to Star"
                                Width="105"
                                Height="35"
                                Margin="0,0,8,0"
                                Background="#00A6A6"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="FlyToSelectedStar_Click"/>

                        <Button Content="Reset View"
                                Width="105"
                                Height="35"
                                Background="#374151"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="ResetView_Click"/>

                    </StackPanel>

                    <!-- Selected Star Name -->
                    <TextBlock Text="SELECTED STAR"
                               Foreground="#8191AA"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="StarNameText"
                               Text="No star selected"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,5,0,5"/>

                    <TextBlock x:Name="StarIdText"
                               Text="Catalogue ID: --"
                               Foreground="#8FA9D6"
                               FontSize="11"
                               Margin="0,0,0,20"/>

                    <Border Height="1"
                            Background="#26364F"
                            Margin="0,0,0,18"/>

                    <!-- Spectral Classification -->
                    <TextBlock Text="SPECTRAL TYPE"
                               Foreground="#8191AA"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="SpectralTypeText"
                               Text="--"
                               Foreground="#FFD166"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,5,0,18"/>

                    <!-- Constellation -->
                    <TextBlock Text="CONSTELLATION"
                               Foreground="#8191AA"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="ConstellationText"
                               Text="--"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,5,0,18"/>

                    <!-- Distance -->
                    <TextBlock Text="DISTANCE FROM EARTH"
                               Foreground="#8191AA"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="DistanceText"
                               Text="--"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,5,0,18"/>

                    <!-- Apparent Magnitude -->
                    <TextBlock Text="APPARENT MAGNITUDE"
                               Foreground="#8191AA"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="ApparentMagnitudeText"
                               Text="--"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,5,0,18"/>

                    <!-- Absolute Magnitude -->
                    <TextBlock Text="ABSOLUTE MAGNITUDE"
                               Foreground="#8191AA"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="AbsoluteMagnitudeText"
                               Text="--"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,5,0,18"/>

                    <Border Height="1"
                            Background="#26364F"
                            Margin="0,0,0,18"/>

                    <!-- 3D Coordinates -->
                    <TextBlock Text="3D COORDINATES"
                               Foreground="#8FA9D6"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="XCoordinateText"
                               Text="X: --"
                               Foreground="#FF8585"
                               FontSize="13"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="YCoordinateText"
                               Text="Y: --"
                               Foreground="#80D6A5"
                               FontSize="13"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="ZCoordinateText"
                               Text="Z: --"
                               Foreground="#80BFFF"
                               FontSize="13"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Coordinates are in light-years."
                               Foreground="#65758E"
                               FontSize="10"
                               Margin="0,8,0,0"/>

                    <Border Height="1"
                            Background="#26364F"
                            Margin="0,18,0,18"/>

                    <!-- Nearby Stars Section -->
                    <TextBlock Text="NEARBY STARS"
                               Foreground="#00A6A6"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Stars within 10 light-years"
                               Foreground="LightGray"
                               FontSize="11"
                               Margin="0,0,0,10"/>

                    <ListBox x:Name="NearbyStarsList"
                             Height="220"
                             Background="#202833"
                             Foreground="White"
                             BorderBrush="#374151"
                             BorderThickness="1"
                             FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    <Border Height="1"
                            Background="#26364F"
                            Margin="0,18,0,12"/>

                    <!-- Selection Status -->
                    <TextBlock x:Name="SelectionStatusText"
                               Text="Click a star in the chart to view its details."
                               Foreground="#8FA9D6"
                               FontSize="11"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
