{
	"metadata": [
		{
			"src": [
				{
					"src": "02Assignment2_BOOSE_ProgrammingLanguage",
					"files": [
						"**/*.csproj"
					],
					"exclude": [
						"**/bin/**",
						"**/obj/**"
					]
				}
			],
			"dest": "api"
		}
	],
	"build": {
		"content": [
			{
				"files": [
					"api/*.{md,yml}",
					"**/*.md",
					"toc.yml"
				],
				"exclude": [
					"docs/**"
				]
			}
		],
		"output": "docs",
		"template": [
			"default",
			"modern"
		],
		"globalMetadata": {
			"_appName": " [put my name here] BOOSE Programming Language Implementation",
			"_appTitle": "BOOSE Documentation",
			"_enableSearch": true
		}
	}
}